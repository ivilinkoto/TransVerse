{
  "packageId": "com.transversebg.app",
  "host": "transverse-bg.com",
  "name": "TransVerse — транспортна игра",
  "launcherName": "TransVerse",
  "display": "standalone",
  "orientation": "default",
  "themeColor": "#05070B",
  "themeColorDark": "#05070B",
  "navigationColor": "#05070B",
  "navigationColorDark": "#05070B",
  "navigationDividerColor": "#00000000",
  "navigationDividerColorDark": "#00000000",
  "backgroundColor": "#05070B",
  "enableNotifications": true,
  "enableSiteSettingsShortcut": true,
  "startUrl": "/game?app=android",
