{
  "name": "transverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "geo:import": "tsx scripts/import-geonames.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@mapbox/polyline": "1.2.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.58.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
