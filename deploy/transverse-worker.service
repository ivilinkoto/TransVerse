[Unit]
Description=TransVerse world worker (deliveries, market, payroll, seasons)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/transverse/current
EnvironmentFile=/etc/transverse/transverse.env
# Keep the JavaScript heap under MemoryMax: Node then cleans up memory in time instead of the
# process being killed for it (a killed web process = 502 for every player until it is back).
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node --enable-source-maps dist/worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryMax=400M

[Install]
WantedBy=multi-user.target
