[Unit]
Description=TransVerse world worker (deliveries, market, payroll, seasons)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/transverse/current
EnvironmentFile=/etc/transverse/transverse.env
# Keep the JavaScript heap under MemoryMax: Node then cleans up memory in time instead of the
# process being killed for it (a killed web process = 502 for every player until it is back).
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/node --enable-source-maps dist/worker.js
Restart=always
# A stop (a deploy, a restart) waits at most 10 s, then every process of the service is killed.
# Before: open live connections kept the old site up to the 90 s timeout, and a left-over
# process held memory and the port while the new one failed to start.
TimeoutStopSec=10
KillMode=mixed
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryMax=600M

[Install]
WantedBy=multi-user.target
