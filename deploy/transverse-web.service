[Unit]
Description=TransVerse web (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/transverse/current/app
EnvironmentFile=/etc/transverse/transverse.env
# Keep the JavaScript heap under MemoryMax: Node then cleans up memory in time instead of the
# process being killed for it (a killed web process = 502 for every player until it is back).
Environment=NODE_OPTIONS=--max-old-space-size=640
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# No MemoryHigh: above it the kernel throttles the process and every player waits.
# MemoryMax is the last resort; fix-502.sh fits both limits to the server's RAM
# (/etc/systemd/system/transverse-web.service.d/memory.conf).
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
