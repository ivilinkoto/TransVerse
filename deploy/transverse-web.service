[Unit]
Description=TransVerse web (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/transverse/current/app
EnvironmentFile=/etc/transverse/transverse.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryMax=900M

[Install]
WantedBy=multi-user.target
