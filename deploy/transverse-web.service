[Unit]
Description=TransVerse web (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/transverse/current/app
EnvironmentFile=/etc/transverse/transverse.env
# Keep the JavaScript heap under MemoryMax: Node then cleans up memory in time instead of the
# process being killed for it (a killed web process = 502 for every player until it is back).
Environment=NODE_OPTIONS=--max-old-space-size=640
# glibc gives every thread its own memory arena and seldom gives it back: the site grew to
# 4+ GB of native memory with a 200 MB JavaScript heap. Two arenas keep it small.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/node server.js
Restart=always
# A stop (a deploy, a restart) waits at most 10 s, then every process of the service is killed.
# Before: open live connections kept the old site up to the 90 s timeout, and a left-over
# process held memory and the port while the new one failed to start.
TimeoutStopSec=10
KillMode=mixed
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# No MemoryHigh: above it the kernel throttles the process and every player waits.
# MemoryMax is the last resort; fix-502.sh fits both limits to the server's RAM
# (/etc/systemd/system/transverse-web.service.d/memory.conf).
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
