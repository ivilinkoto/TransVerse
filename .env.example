# PostgreSQL connection string
DATABASE_URL=postgres://transverse:CHANGE_ME@localhost:5432/transverse

# Routing: "valhalla" (real truck routing) or "approximate" (great-circle estimate, clearly labelled in UI)
ROUTING_PROVIDER=valhalla
# Public FOSSGIS instance is for development only — self-host Valhalla for production traffic.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Map style (MapLibre). OpenFreeMap is free, no key, commercial use allowed (attribution required).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Set to "true" behind HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false

# Sign-ups per IP per hour (keep low in production)
REGISTER_LIMIT_PER_HOUR=5

# ── Payments (Stripe Checkout). Leave empty to keep real-money purchases switched off.
# Secret key (sk_test_… for testing, sk_live_… for real money) and the webhook signing secret (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public address of the site (HTTPS in production), used for the return pages after payment.
APP_URL=https://transverse.bg
# Seller details shown in the terms and privacy pages (required before selling).
SELLER_NAME=
SELLER_ID=
SELLER_ADDRESS=
SUPPORT_EMAIL=
# "true" to let Stripe Tax calculate VAT (prices stay VAT-inclusive)
STRIPE_AUTOMATIC_TAX=false
