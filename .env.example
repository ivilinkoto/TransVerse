# PostgreSQL connection string
DATABASE_URL=postgres://transverse:CHANGE_ME@localhost:5432/transverse

# Routing: "valhalla" (real truck routing) or "approximate" (great-circle estimate, clearly labelled in UI)
ROUTING_PROVIDER=valhalla
# Public FOSSGIS instance is for development only — self-host Valhalla for production traffic.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Map style (MapLibre). OpenFreeMap is free, no key, commercial use allowed (attribution required).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Set to "true" behind HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false

# Sign-ups per IP per hour (keep low in production)
REGISTER_LIMIT_PER_HOUR=5

# ── Payments. Leave empty to keep real-money purchases switched off.
# In production these come from GitHub Secrets (written by Deploy to /var/www/transverse/shared/secrets.env).
# PayPal REST app (developer.paypal.com → Apps & Credentials). PAYPAL_ENV=sandbox for testing, live for real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook id for refunds/chargebacks made in PayPal (needs HTTPS)
PAYPAL_WEBHOOK_ID=
# Stripe Checkout (for later, needs a domain with HTTPS).
# Secret key (sk_test_… for testing, sk_live_… for real money) and the webhook signing secret (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public address of the site, used for the return pages after payment (optional: defaults to the address the player uses).
APP_URL=https://transverse.bg
# Seller details shown in the terms and privacy pages (required before selling).
SELLER_NAME=
SELLER_ID=
SELLER_ADDRESS=
SUPPORT_EMAIL=
# "true" to let Stripe Tax calculate VAT (prices stay VAT-inclusive)
STRIPE_AUTOMATIC_TAX=false

# ── E-mail (confirm address, forgotten password). Any SMTP provider. Empty = no e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TransVerse <no-reply@transverse-bg.com>

# ── Push notifications. Optional: without them keys are generated once and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@transverse-bg.com
