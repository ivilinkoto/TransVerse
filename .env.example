# PostgreSQL connection string
DATABASE_URL=postgres://transverse:CHANGE_ME@localhost:5432/transverse

# Routing: "valhalla" (real truck routing) or "approximate" (great-circle estimate, clearly labelled in UI)
ROUTING_PROVIDER=valhalla
# Public FOSSGIS instance is for development only — self-host Valhalla for production traffic.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Map style (MapLibre). OpenFreeMap is free, no key, commercial use allowed (attribution required).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Set to "true" behind HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false
